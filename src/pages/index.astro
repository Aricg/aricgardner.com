---
const services: { title: string; description: string }[] = [
  {
    title: 'Websites',
    description: 'Fast, sharp web experiences that make your offer legible and your stack easy to run.',
  },
  {
    title: 'Automation',
    description: 'Scripts, dashboards, and integrations that turn repetitive workflows into reliable systems.',
  },
  {
    title: 'Technical Support',
    description: 'Hands-on help with servers, deployments, debugging, and keeping production systems stable.',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Aric Gardner</title>
    <meta
      name="description"
      content="Aric Gardner provides practical software, automation, and technology consulting for small businesses and teams."
    />
  </head>
  <body>
    <div class="ambient" aria-hidden="true"></div>
    <main>
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow">Aric Gardner // Software Systems</p>
          <h1 id="hero-title">Practical software with a sharper signal.</h1>
          <p class="intro">
            I help teams turn messy workflows into reliable tools, websites, integrations, and systems that are easier
            to run and maintain.
          </p>
          <div class="actions">
            <a class="contact" href="mailto:aric@aricgardner.com">Contact Aric</a>
            <a class="product-link" href="/sentinel-winter/">Sentinel Winter</a>
            <span class="status">Available for focused builds</span>
          </div>
        </div>

        <div class="terminal-panel" aria-label="Current focus">
          <div class="terminal-bar">
            <span></span>
            <span></span>
            <span></span>
          </div>
          <p class="prompt">~/aricgardner.com</p>
          <p><span>build</span> websites</p>
          <p><span>wire</span> automations</p>
          <p><span>ship</span> stable systems</p>
        </div>
      </section>

      <section class="services" aria-label="Services">
        {
          services.map((service) => (
            <article class="service">
              <h2>{service.title}</h2>
              <p>{service.description}</p>
            </article>
          ))
        }
      </section>

      <footer>
        <span>&copy; 2026 Aric Gardner. Built for aricgardner.com.</span>
      </footer>
    </main>
  </body>
</html>

<style>
  :root {
    color-scheme: dark;
    --bg: #050611;
    --ink: #f4fbff;
    --muted: #a8b8c7;
    --cyan: #41f5ff;
    --magenta: #ff3df2;
    --lime: #d5ff62;
    --panel: rgba(8, 12, 28, 0.68);
    --panel-strong: rgba(9, 14, 34, 0.88);
    --line: rgba(88, 245, 255, 0.3);
    --line-hot: rgba(255, 61, 242, 0.42);
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    min-height: 100vh;
    overflow-x: hidden;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    color: var(--ink);
    background:
      linear-gradient(90deg, rgba(5, 6, 17, 0.96) 0%, rgba(5, 6, 17, 0.78) 45%, rgba(5, 6, 17, 0.55) 100%),
      linear-gradient(180deg, rgba(5, 6, 17, 0.2), var(--bg) 86%),
      url("/assets/hypr-vapor-hero.png") center top / cover no-repeat fixed,
      var(--bg);
    line-height: 1.55;
  }

  body::before,
  body::after,
  .ambient {
    position: fixed;
    inset: 0;
    pointer-events: none;
  }

  body::before {
    content: "";
    z-index: -2;
    background-image:
      linear-gradient(rgba(65, 245, 255, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 61, 242, 0.05) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.9), transparent 84%);
  }

  body::after {
    content: "";
    z-index: -1;
    background: repeating-linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.035) 0,
      rgba(255, 255, 255, 0.035) 1px,
      transparent 1px,
      transparent 5px
    );
    mix-blend-mode: overlay;
    opacity: 0.45;
  }

  .ambient {
    z-index: -3;
    background:
      radial-gradient(circle at 80% 16%, rgba(255, 61, 242, 0.42), transparent 28%),
      radial-gradient(circle at 18% 78%, rgba(65, 245, 255, 0.22), transparent 31%),
      linear-gradient(135deg, rgba(213, 255, 98, 0.06), transparent 44%);
    filter: blur(18px);
  }

  main {
    width: min(1120px, calc(100% - 32px));
    margin: 0 auto;
    padding: 40px 0 36px;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 360px);
    align-items: end;
    min-height: calc(100svh - 40px);
    gap: 40px;
    padding: 80px 0 88px;
  }

  .hero-copy {
    max-width: 810px;
  }

  .eyebrow {
    display: inline-flex;
    margin: 0 0 18px;
    padding: 8px 11px;
    border: 1px solid var(--line);
    color: var(--cyan);
    background: rgba(3, 8, 22, 0.72);
    box-shadow: 0 0 28px rgba(65, 245, 255, 0.18);
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    color: var(--ink);
    font-size: clamp(3rem, 8vw, 7.8rem);
    font-weight: 900;
    line-height: 0.88;
    letter-spacing: 0;
    text-shadow:
      0 0 22px rgba(65, 245, 255, 0.22),
      0 0 54px rgba(255, 61, 242, 0.17);
  }

  .intro {
    max-width: 660px;
    margin: 30px 0 34px;
    color: var(--muted);
    font-size: clamp(1.05rem, 2vw, 1.28rem);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
  }

  .contact {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 20px;
    border: 1px solid rgba(65, 245, 255, 0.78);
    color: #051019;
    background: linear-gradient(90deg, var(--cyan), var(--lime));
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.12) inset,
      0 0 34px rgba(65, 245, 255, 0.42);
    text-decoration: none;
    font-weight: 900;
  }

  .contact:hover,
  .contact:focus-visible,
  .product-link:hover,
  .product-link:focus-visible {
    transform: translateY(-1px);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.18) inset,
      0 0 44px rgba(255, 61, 242, 0.4);
  }

  .product-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 20px;
    border: 1px solid var(--line-hot);
    color: var(--ink);
    background: rgba(8, 12, 28, 0.74);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.08) inset,
      0 0 28px rgba(255, 61, 242, 0.24);
    text-decoration: none;
    font-weight: 900;
    backdrop-filter: blur(16px);
  }

  .status {
    color: var(--muted);
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    font-size: 0.88rem;
  }

  .status::before {
    content: "";
    display: inline-block;
    width: 9px;
    height: 9px;
    margin-right: 10px;
    border-radius: 999px;
    background: var(--lime);
    box-shadow: 0 0 18px var(--lime);
  }

  .terminal-panel {
    align-self: center;
    padding: 18px;
    border: 1px solid var(--line);
    background: var(--panel);
    box-shadow:
      0 24px 90px rgba(0, 0, 0, 0.42),
      0 0 52px rgba(65, 245, 255, 0.17),
      0 0 0 1px rgba(255, 61, 242, 0.14) inset;
    backdrop-filter: blur(18px);
  }

  .terminal-bar {
    display: flex;
    gap: 8px;
    margin-bottom: 22px;
  }

  .terminal-bar span {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: var(--cyan);
    box-shadow: 0 0 14px currentColor;
  }

  .terminal-bar span:nth-child(2) {
    background: var(--magenta);
  }

  .terminal-bar span:nth-child(3) {
    background: var(--lime);
  }

  .terminal-panel p {
    margin: 0;
    color: #e8fbff;
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    font-size: 0.95rem;
  }

  .terminal-panel p + p {
    margin-top: 10px;
  }

  .terminal-panel span,
  .prompt {
    color: var(--cyan);
  }

  .services {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin-top: -42px;
  }

  .service {
    position: relative;
    min-height: 208px;
    overflow: hidden;
    padding: 24px;
    border: 1px solid rgba(65, 245, 255, 0.24);
    background: var(--panel);
    box-shadow:
      0 18px 60px rgba(0, 0, 0, 0.34),
      0 0 0 1px rgba(255, 61, 242, 0.08) inset;
    backdrop-filter: blur(20px);
  }

  .service::before {
    content: "";
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--cyan), var(--magenta), var(--lime));
    opacity: 0.9;
  }

  .service h2 {
    margin: 0 0 12px;
    color: #ffffff;
    font-size: 1.08rem;
    letter-spacing: 0;
  }

  .service p {
    margin: 0;
    color: var(--muted);
  }

  footer {
    margin-top: 64px;
    padding-top: 24px;
    border-top: 1px solid rgba(65, 245, 255, 0.18);
    color: rgba(168, 184, 199, 0.78);
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    font-size: 0.82rem;
  }

  @media (max-width: 900px) {
    body {
      background-position: 62% top;
      background-attachment: scroll;
    }

    .hero {
      grid-template-columns: 1fr;
      min-height: auto;
      padding: 68px 0 92px;
    }

    .terminal-panel {
      max-width: 420px;
    }

    .services {
      grid-template-columns: 1fr;
      margin-top: -36px;
    }
  }

  @media (max-width: 560px) {
    main {
      width: min(100% - 28px, 1120px);
      padding-top: 24px;
    }

    .hero {
      gap: 28px;
      padding: 52px 0 78px;
    }

    .eyebrow {
      font-size: 0.7rem;
    }

    .actions {
      align-items: flex-start;
      flex-direction: column;
    }

    .contact {
      width: 100%;
    }

    .product-link {
      width: 100%;
    }
  }
</style>
